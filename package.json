{
  "name": "@ratmath/graphics",
  "version": "0.1.0",
  "description": "Exact-rational graphics for RatMath: fast float sketches while exploring, certified pixel-exact plots when settled; graphs, parametric and polar curves, regions, exact geometry, and exports to SVG, TikZ, PDF, PNG and text",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./worker": {
      "types": "./worker.d.ts",
      "default": "./src/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "worker.d.ts",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test ./tests",
    "docs:build": "bun scripts/build-docs.js",
    "demo:build": "bun build demo/main.js --outdir demo/dist --target browser",
    "demo": "bun run demo:build && bunx serve demo"
  },
  "keywords": [
    "rational",
    "exact",
    "interval",
    "certified",
    "plot",
    "graph",
    "ratmath"
  ],
  "author": "James Taylor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmath/graphics.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ratmath/analytic": "^0.1.0",
    "@ratmath/algebraic": "^0.1.0"
  },
  "peerDependencies": {
    "@ratmath/core": ">=0.10.0 <0.12.0"
  },
  "devDependencies": {
    "@ratmath/core": "^0.11.0",
    "katex": "0.19.1"
  },
  "workspaces": [
    "vendor/*"
  ],
  "homepage": "https://ratmath.com/graphics/",
  "bugs": {
    "url": "https://github.com/ratmath/graphics/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
