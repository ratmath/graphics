{
  "name": "@ratmath/graphics",
  "version": "0.1.0",
  "description": "Exact-rational graphics for RatMath: fast float sketches while exploring, certified pixel-exact plots when settled",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.js", "default": "./index.js" },
    "./package.json": "./package.json"
  },
  "files": ["index.js", "index.d.ts", "src/", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "test": "bun test ./tests",
    "demo:build": "bun build demo/main.js --outdir demo/dist --target browser",
    "demo": "bun run demo:build && bunx serve demo"
  },
  "keywords": ["rational", "exact", "interval", "certified", "plot", "graph", "ratmath"],
  "author": "James Taylor",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/ratmath/graphics.git" },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@ratmath/core": "^0.8.0"
  }
}
